{
  "name": "@gitkittie/gitkanban-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that turns a repo's GitHub push webhook into live \"these paths changed\" events for the GitKanban apps.",
  "scripts": {
