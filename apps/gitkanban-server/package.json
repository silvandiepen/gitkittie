{
  "name": "@gitkittie/gitkanban-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Always-on file server exposing one local folder to the GitKanban apps over Tailscale.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
